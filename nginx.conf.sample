# PatSons Foods Goa - Optimized Nginx Server Block
# Dev Can Fruit Products, Morjim, Pernem - Goa

server {
    listen 80;
    listen [::]:80;
    server_name patsonsfoods.com www.patsonsfoods.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name patsonsfoods.com www.patsonsfoods.com;

    root /var/www/patsonsSSL/git/public;
    index index.php index.html;

    # SSL Certificates (Configure with Let's Encrypt / Certbot)
    # ssl_certificate /etc/letsencrypt/live/patsonsfoods.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/patsonsfoods.com/privkey.pem;

    # Charset
    charset utf-8;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy "strict-origin-when-cross-origin";

    # ----------------------------------------------------------------------
    # High-Performance Browser Caching (1-Year Immutable for WebP & Images)
    # ----------------------------------------------------------------------
    location ~* \.(webp|png|jpe?g|gif|ico|svg|avif)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    # Fonts - 1 Year Cache
    location ~* \.(woff2?|eot|ttf|otf)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    # CSS & JS - 1 Month Cache
    location ~* \.(css|js)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    # Gzip / Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Laravel Front Controller
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    # PHP-FPM Handling
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock; # Adjust PHP version as needed
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_buffer_size 16k;
        fastcgi_buffers 4 16k;
    }

    # Block sensitive files
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
